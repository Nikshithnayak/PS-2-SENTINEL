# Database (leave unset in local Windows dev to auto-start embedded PostgreSQL on port 5433)
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# Service URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENGINE_URL=http://127.0.0.1:8000
ENGINE_INTERNAL_TOKEN=dev-engine-internal-token-change-in-prod

# Security & Auth (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=dev-better-auth-secret-replace-with-64-hex-chars-in-production-00
BETTER_AUTH_URL=http://localhost:3000
# 32-byte hex key (64 hex characters) for AES-256-GCM field-level PHI encryption
PHI_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Emergency Defaults (India 112 / 108)
DEFAULT_EMERGENCY_NUMBER=112
DEFAULT_AMBULANCE_NUMBER=108

# Optional Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@sentinel.local

# Optional Live Wearable Providers
OPEN_WEARABLES_URL=
OPEN_WEARABLES_API_KEY=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# Optional Alert Channels
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SENTINEL Care <alerts@sentinel.local>
CLOUDFLARE_INBOX_WEBHOOK_SECRET=dev-inbox-webhook-secret-change-in-prod
TELEGRAM_BOT_TOKEN=
NTFY_TOPIC_URL=
ENABLE_SMS_ADAPTER=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Feature Flags (off by default)
ENABLE_AUTOENCODER_L3=false
LLM_PHRASING_API_KEY=
LLM_PHRASING_BASE_URL=
LLM_PHRASING_MODEL=gpt-4o-mini
OPEN_LLM_VTUBER_WS_URL=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
